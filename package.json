{
  "name": "nyc-violations-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for NYC building violations (DOB, ECB, HPD) from NYC Open Data",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "nyc-violations-mcp": "dist/src/index.js"
  },
  "engines": {
    "node": ">=22"
